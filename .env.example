# Unstream — optional settings.
#
#   cp .env.example .env
#
# You do not need this file. `docker compose up -d` works with none of it
# set, and the defaults in docker-compose.yml are already the self-hosting
# ones. Everything below is commented out and shows the value you would get
# by leaving it that way.
#
# There are no API keys here, and there is nothing to sign up for. Every
# metadata provider Unstream uses is public and keyless, which is a
# constraint the project keeps on purpose.


# ── Where it listens ─────────────────────────────────────────────────────────

# Host port for the web UI. Change it if 8080 is taken.
#UNSTREAM_PORT=8080


# ── Where the files go ───────────────────────────────────────────────────────

# The folder finished tracks land in, as ./downloads/<job-id>/. Point it at an
# external disk, a NAS mount, or whatever your music player already watches.
# Use a path, not a bare name — `downloads` would be read as a named volume,
# `./downloads` as a folder.
#DOWNLOADS_DIR=./downloads

# Who owns what lands there. 1001 is the user inside the image; set these to
# your own (`id -u` and `id -g`) so the files are yours and not root's.
# Linux only — Docker Desktop on macOS and Windows maps ownership for you.
#PUID=1001
#PGID=1001


# ── Keeping what you downloaded ──────────────────────────────────────────────

# Hours before a finished download is deleted. 0 = never, which is the
# default here and almost certainly what you want on your own machine.
# (The code itself defaults to 24, for public servers.)
#DOWNLOADS_TTL_HOURS=0

# Disk ceiling in GB. Over it, finished jobs are deleted oldest-first.
# 0 = no ceiling. Running jobs are never touched either way.
#MAX_DOWNLOADS_GB=0


# ── Limits ───────────────────────────────────────────────────────────────────
#
# What one caller — one IP — can cost the server. On a public instance these
# are the difference between a service and an open relay. On a machine whose
# only user is you, they are just something to bump into, so the compose file
# turns them off.
#
# TURN THEM BACK ON if you put this anywhere someone you don't know can reach
# it — a port-forward, a tunnel, a VPS. That is the entire difference between
# this being your downloader and being everyone's.
#RATE_LIMITS_ENABLED=false

# The individual budgets, which only apply when the above is on.
#RATE_SEARCH_PER_MINUTE=15       # searches; four providers fan out per call
#RATE_RESOLVE_PER_MINUTE=30      # pasted links and artist pages
#RATE_DOWNLOADS_PER_HOUR=20      # download jobs started
#RATE_FILES_PER_MINUTE=60        # finished files served
#RATE_ZIPS_PER_HOUR=30           # ZIPs, which are a whole album per request
#RATE_COLLECT_PER_MINUTE=30      # analytics beacons; only matters with ADMIN_TOKEN set
#RATE_JOBS_PER_MINUTE=120        # job-status polling requests

# Wrong admin tokens are rate limited whether or not the switch above is on,
# and that is not configurable. It is the only thing in front of /admin.

# These two are a different class — they bound threads and memory rather than
# anyone's fair share — so they still apply with rate limits off. 0 = no
# limit, which is the default here because a full discography is one job of
# several hundred tracks.
#MAX_ACTIVE_JOBS_PER_CLIENT=0
#MAX_TRACKS_PER_JOB=0
#MAX_QUEUED_TRACKS=0              # total queued/running tracks; 0 = unlimited
#JOB_METADATA_TTL_HOURS=168       # in-memory job status retention; files are separate

# Tracks downloaded in parallel, and the real bound on what runs at once.
# Raising it finishes a long album sooner and gets you bot-checked sooner,
# in that order — move it in small steps.
#DOWNLOAD_WORKERS=3


# ── Getting audio out of YouTube ─────────────────────────────────────────────
#
# You can most likely ignore this whole section. YouTube bot-checks datacenter
# addresses long before it bothers a home connection, so the defences below
# matter on a rented server and are usually dead weight on a home one. If
# downloads fail with "Sign in to confirm you're not a bot", start here — and
# check GET /api/admin/extraction, which reports what actually landed in the
# container.

# Lets yt-dlp fetch the JS challenge solver it needs to turn a format into a
# stream URL. Set it to an empty string to refuse the download; expect
# YouTube to then hand back videos carrying no audio streams at all.
#YTDLP_REMOTE_COMPONENTS=ejs:github

# The pot-provider sidecar, which mints the proof-of-origin tokens YouTube
# asks some clients for. Free and keyless. Unset it for plain anonymous
# extraction.
#POT_PROVIDER_URL=http://pot-provider:4416

# Last resort, and only if the two above are not enough. Sign in with a
# THROWAWAY Google account: every download this server makes is attributed to
# it, and YouTube bans accounts for exactly that. Export the cookies from a
# private window you then close, or your browser will rotate them out from
# under the file.
#
# The default compose file mounts no cookie file, so setting this alone does
# nothing. Create a docker-compose.override.yml next to it — compose merges
# that automatically — with:
#
#   services:
#     api:
#       volumes:
#         - ./cookies.txt:/app/cookies.txt
#
# Read-write on purpose: yt-dlp writes rotated cookies back, and :ro would
# let the session decay over a few days.
#YTDLP_COOKIEFILE=/app/cookies.txt


# ── Analytics ────────────────────────────────────────────────────────────────
#
# Off unless you set a token below, and local either way: the numbers go into
# a SQLite file on the analytics volume and are only ever read back by /admin
# on this instance. Nothing is sent anywhere, there is no third-party service
# and there is no cookie. Callers are identified by a daily-rotating hash of
# IP + user agent, so no address is ever stored.

# Enables /admin. Unset, the dashboard does not exist and /api/admin/*
# returns 503. Invent one — it is a password, not a credential from anyone:
#   openssl rand -hex 24
#ADMIN_TOKEN=

# Which day an event counts in. 0 = UTC, 210 = Tehran.
#ANALYTICS_UTC_OFFSET_MINUTES=0

# How long rows are kept.
#ANALYTICS_RETENTION_DAYS=90
